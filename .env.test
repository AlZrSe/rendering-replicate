# Vitest environment (`npm test`).
#
# The unit + integration suite runs against the mock deliberately, so it needs
# neither a backend nor a dev server. `src/services/index.test.ts` asserts this
# value is loaded and then actively defeats it to prove nothing else selects
# the mock.
#
# The Playwright suite (`npm run test:e2e`) is a different thing: it needs a real
# backend and starts `npm run dev`, which reads .env.development instead.
VITE_CLUSTER_BACKEND=mock

VITE_API_URL=http://localhost:8000/api/v1