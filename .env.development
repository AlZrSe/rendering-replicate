# Frontend development environment (`npm run dev`).
#
# Which ClusterService implementation runs — see src/services/index.ts:
#   the exact value "mock" -> mockService (in-memory demo data)
#   anything else, or unset -> httpService (the real FastAPI backend)
# The match is exact and case-sensitive; no health probe, no fallback.
VITE_CLUSTER_BACKEND=http

# Default API base URL. Overridable at runtime from the login screen or the
# settings page, which persist to localStorage["shc.settings"].
#
# To run the whole UI with no backend, create the gitignored
# .env.development.local and set the mode to "mock" there — see the
# "Running with no backend" section of README.md for the exact snippet.
VITE_API_URL=http://localhost:8000/api/v1