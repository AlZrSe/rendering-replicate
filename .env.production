# Frontend production environment (`npm run build`).
#
# A shipped build always talks to the real backend. The mock is not reachable
# from here: the mode is baked in at build time, so anything other than the
# exact value "mock" resolves to httpService.
VITE_CLUSTER_BACKEND=http

# Default API base URL for production builds. This is the *default*, not a lock:
# anyone can retarget a deployed build from the settings page or the login
# screen, which persist to localStorage["shc.settings"]. Change this here if you
# want the value baked in at build time.
#
# It is left at localhost so that `npm run preview` on a developer machine
# behaves exactly as it did before this variable was read. Do NOT leave a
# placeholder hostname here — unlike an unused variable, a wrong one is baked
# into every build that ships with it.
VITE_API_URL=http://localhost:8000/api/v1