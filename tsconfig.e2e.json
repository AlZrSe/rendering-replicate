{
  // The Playwright program, deliberately separate from tsconfig.json.
  //
  // `npm run typecheck` does NOT check this project. Playwright drives the app
  // in Node against a live backend; the main program is the jsdom/vitest one.
  // Merging the two would mean reconciling their `lib`/`types` setups to fix
  // nothing, and it would reverse the recorded decision (issue #30, Q3) that
  // the two runners own disjoint file sets.
  //
  // This file exists so the boundary is a config file rather than a comment.
  // The 8 known errors in `tests/e2e/**` were fixed in issue #46. The count
  // below is now 0. `npm run typecheck:e2e` exits 0 and prints no errors.
  //
  // `playwright.config.ts` is deliberately not pulled in: it carries 4 errors
  // of its own and is tracked separately.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // A Node program. The vitest program pins `types: ["vite/client"]`, which
    // carries no node globals at all; a Playwright spec that reads `process.env`
    // would fail without this.
    "types": ["node"],
    "noEmit": true
  },
  // `tests/e2e/**` only. `playwright.config.ts` is deliberately not pulled in:
  // it is untouched by issue #39 and carries 4 further errors of its own, so
  // including it would blur which 8 are the tracked ones.
  "include": ["tests/e2e/**/*.ts"]
}
